<template>
  <div class="list-page">
    <div class="page-header">
      <h1>{{ modelPluralTitle }}</h1>
      <router-link :to="`/admin/module/${moduleSlug}/{{ modelPlural }}/create`" class="btn-primary">
        + Create
      </router-link>
    </div>

    <div class="card">
      <div class="toolbar">
        <input v-model="search" type="text" placeholder="Search..." class="search-input" @input="onSearch" />
        <span class="total-badge">{{ meta.total }} item{{ meta.total !== 1 ? 's' : '' }}</span>
      </div>

      <table class="data-table" v-if="items.length">
        <thead>
          <tr>
            <th>Title</th>
            <th>Status</th>
            <th>Created</th>
            <th class="actions-col"></th>
          </tr>
        </thead>
        <tbody>
          <tr v-for="item in items" :key="item.id">
            <td class="title-cell">{{ item.title }}</td>
            <td><span :class="['status-badge', item.status]">{{ item.status }}</span></td>
            <td class="date-cell">{{ formatDate(item.created_at) }}</td>
            <td class="actions-cell">
              <router-link :to="`/admin/module/${moduleSlug}/{{ modelPlural }}/edit?id=${item.id}`" class="action-link">Edit</router-link>
              <button class="action-link danger" @click="confirmDelete(item)">Delete</button>
            </td>
          </tr>
        </tbody>
      </table>

      <div v-else-if="!loading" class="empty-state">
        <p>No items found.</p>
      </div>

      <div v-if="loading" class="loading-state">Loading...</div>

      <div class="pagination" v-if="meta.last_page > 1">
        <button :disabled="meta.current_page <= 1" @click="goTo(meta.current_page - 1)">Previous</button>
        <span class="page-info">Page {{ meta.current_page }} of {{ meta.last_page }}</span>
        <button :disabled="meta.current_page >= meta.last_page" @click="goTo(meta.current_page + 1)">Next</button>
      </div>
    </div>

    <div v-if="deleting" class="modal-overlay" @click.self="deleting = null">
      <div class="modal">
        <h3>Delete</h3>
        <p>Are you sure you want to delete <strong>{{ deleting.title }}</strong>?</p>
        <div class="modal-actions">
          <button class="btn-cancel" @click="deleting = null">Cancel</button>
          <button class="btn-danger" @click="doDelete" :disabled="deletingBusy">
            {{ deletingBusy ? 'Deleting...' : 'Delete' }}
          </button>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import { ref, reactive, onMounted } from 'vue';
import { useRoute } from 'vue-router';
import axios from 'axios';
import { message } from 'ant-design-vue';

export default {
  name: '{{ model }}List',
  setup() {
    const route = useRoute();
    const moduleSlug = route.params.slug;
    const items = ref([]);
    const meta = reactive({ current_page: 1, last_page: 1, per_page: 15, total: 0 });
    const loading = ref(true);
    const search = ref('');
    const deleting = ref(null);
    const deletingBusy = ref(false);
    let searchTimeout = null;

    const fetchItems = async (page = 1) => {
      loading.value = true;
      try {
        const params = { page, per_page: 15 };
        if (search.value) params.search = search.value;
        const { data } = await axios.get('/api/{{ moduleAlias }}', { params });
        items.value = data.data;
        Object.assign(meta, data.meta);
      } catch (e) {
        console.error('Failed to fetch:', e);
        items.value = [];
      } finally {
        loading.value = false;
      }
    };

    const onSearch = () => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => fetchItems(1), 300);
    };

    const goTo = (page) => {
      if (page >= 1 && page <= meta.last_page) fetchItems(page);
    };

    const formatDate = (dateStr) => {
      if (!dateStr) return '\u2014';
      const d = new Date(dateStr);
      return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
    };

    const confirmDelete = (item) => { deleting.value = item; };
    const doDelete = async () => {
      deletingBusy.value = true;
      try {
        await axios.delete(`/api/{{ moduleAlias }}/${deleting.value.id}`);
        message.success('Deleted successfully.');
        deleting.value = null;
        await fetchItems(meta.current_page);
      } catch (e) {
        message.error(e.response?.data?.message || 'Failed to delete.');
      } finally {
        deletingBusy.value = false;
      }
    };

    onMounted(() => fetchItems(1));

    return { moduleSlug, items, meta, loading, search, onSearch, goTo, formatDate, deleting, deletingBusy, confirmDelete, doDelete };
  },
};
</script>

<style scoped>
.list-page { padding: 20px; }
.page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
.page-header h1 { font-size: 24px; font-weight: 700; color: #1e293b; margin: 0; }
.btn-primary { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; background: #4f46e5; color: #fff; border-radius: 6px; font-size: 14px; font-weight: 500; text-decoration: none; }
.btn-primary:hover { background: #4338ca; }
.card { background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden; }
.toolbar { display: flex; align-items: center; gap: 12px; padding: 16px 20px; border-bottom: 1px solid #e2e8f0; }
.search-input { flex: 1; padding: 8px 12px; border: 1px solid #e2e8f0; border-radius: 6px; font-size: 14px; outline: none; }
.search-input:focus { border-color: #4f46e5; }
.total-badge { font-size: 13px; color: #64748b; white-space: nowrap; }
.data-table { width: 100%; border-collapse: collapse; }
.data-table th { text-align: left; padding: 12px 20px; font-size: 12px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: .5px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; }
.data-table td { padding: 14px 20px; font-size: 14px; color: #334155; border-bottom: 1px solid #f1f5f9; }
.title-cell { font-weight: 600; color: #1e293b; }
.date-cell { white-space: nowrap; color: #64748b; }
.actions-col { width: 120px; }
.actions-cell { white-space: nowrap; }
.action-link { background: none; border: none; padding: 4px 8px; font-size: 13px; color: #4f46e5; cursor: pointer; text-decoration: none; }
.action-link:hover { text-decoration: underline; }
.action-link.danger { color: #e11d48; }
.status-badge { display: inline-block; padding: 2px 10px; border-radius: 12px; font-size: 12px; font-weight: 500; }
.status-badge.draft { background: #fef3c7; color: #92400e; }
.status-badge.published { background: #d1fae5; color: #065f46; }
.status-badge.archived { background: #e2e8f0; color: #475569; }
.empty-state, .loading-state { padding: 40px; text-align: center; color: #94a3b8; }
.pagination { display: flex; align-items: center; justify-content: center; gap: 16px; padding: 16px 20px; border-top: 1px solid #e2e8f0; }
.pagination button { padding: 6px 14px; border: 1px solid #e2e8f0; border-radius: 6px; background: #fff; font-size: 13px; color: #334155; cursor: pointer; }
.pagination button:disabled { opacity: .4; cursor: default; }
.pagination button:not(:disabled):hover { background: #f1f5f9; }
.page-info { font-size: 13px; color: #64748b; }
.modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.4); display: flex; align-items: center; justify-content: center; z-index: 1000; }
.modal { background: #fff; border-radius: 12px; padding: 24px; max-width: 420px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,.15); }
.modal h3 { font-size: 18px; margin: 0 0 8px; color: #1e293b; }
.modal p { font-size: 14px; color: #475569; margin: 0 0 20px; }
.modal-actions { display: flex; gap: 8px; justify-content: flex-end; }
.btn-cancel { padding: 8px 16px; border: 1px solid #e2e8f0; border-radius: 6px; background: #fff; font-size: 14px; cursor: pointer; }
.btn-danger { padding: 8px 16px; border: none; border-radius: 6px; background: #e11d48; color: #fff; font-size: 14px; cursor: pointer; }
.btn-danger:disabled { opacity: .6; }
</style>
