<template>
  <div class="dashboard-page">
    <h1>{{ moduleName }}</h1>
    <div class="card" v-if="data">
      <pre>{{ data }}</pre>
    </div>
    <div class="card" v-else-if="loading">Loading...</div>
  </div>
</template>

<script>
import { ref, onMounted } from 'vue';
import axios from 'axios';

export default {
  name: '{{ pageComponentName }}',
  setup() {
    const data = ref(null);
    const loading = ref(true);

    onMounted(async () => {
      try {
        const r = await axios.get('/api/{{ moduleAlias }}');
        data.value = r.data;
      } catch (e) {
        console.error('API error:', e);
      } finally {
        loading.value = false;
      }
    });

    return { data, loading };
  },
};
</script>

<style scoped>
.dashboard-page { padding: 20px; }
.dashboard-page h1 { font-size: 24px; font-weight: 700; color: #1e293b; margin: 0 0 20px; }
.card { background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 24px; }
</style>
